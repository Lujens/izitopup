RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Route API calls cleanly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/auth/?(.*)$ /api/auth/index.php?action=$1 [L,QSA]
RewriteRule ^api/products/?(.*)$ /api/products/index.php?action=$1 [L,QSA]
RewriteRule ^api/orders/?(.*)$ /api/orders/index.php?action=$1 [L,QSA]
RewriteRule ^api/payments/?(.*)$ /api/payments/index.php?action=$1 [L,QSA]
RewriteRule ^api/referrals/?(.*)$ /api/referrals/index.php?action=$1 [L,QSA]

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy strict-origin-when-cross-origin

# Block sensitive files
<FilesMatch "\.(sql|env|log|sh|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block direct access to backend folders
<DirectoryMatch "^.*(config|middleware|utils|sql).*$">
  Order Allow,Deny
  Deny from all
</DirectoryMatch>
